#!/usr/bin/env bash
# One-command launcher: sets up the venv on first run, starts the server, opens the UI.
set -euo pipefail
cd "$(dirname "$0")"
if [ ! -d .venv ]; then
  python3 -m venv .venv
  if [ "$(uname -s)-$(uname -m)" = "Darwin-arm64" ]; then req=requirements-mac.txt; else req=requirements-cpu.txt; fi
  .venv/bin/pip install -q --upgrade pip && .venv/bin/pip install -q -r "$req"
fi
[ -f config.toml ] || cp config.example.toml config.toml
PORT=$(grep -E '^port' config.toml | head -1 | sed 's/[^0-9]//g'); PORT=${PORT:-8765}
( sleep 2; command -v open >/dev/null && open "http://127.0.0.1:$PORT" ) &
exec .venv/bin/python -m app.main
